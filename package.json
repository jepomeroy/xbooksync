{
    "name": "XBookSync",
    "description": "Bookmark sync utility for Chrome and Firefox",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "postinstall": "wxt prepare"
    },
    "dependencies": {
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@wxt-dev/auto-icons": "^1.1.2",
        "@wxt-dev/module-react": "^1.1.5",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "web-ext": "^10.5.0",
        "wxt": "^0.21.3"
    }
}
