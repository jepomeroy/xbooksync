{
    "name": "XBookSync",
    "description": "Bookmark sync utility for Chrome and Firefox",
    "private": true,
    "version": "0.6.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "test": "vitest run",
        "test:watch": "vitest",
        "compile": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "postinstall": "wxt prepare",
        "clean": "wxt clean",
        "dependabot": "npm i --package-lock-only"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "typescript-eslint": "^8.73.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@wxt-dev/auto-icons": "^1.1.2",
        "@wxt-dev/module-react": "^1.2.2",
        "eslint": "^10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "happy-dom": "^21.0.4",
        "typescript": "~6.0.3",
        "vitest": "^5.1.0",
        "web-ext": "^10.8.0",
        "wxt": "^0.21.5"
    }
}
